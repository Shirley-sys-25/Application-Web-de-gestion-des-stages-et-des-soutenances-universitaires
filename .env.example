# Copier ce fichier vers .env, puis adapter les valeurs.
# .env n'est jamais versionné (voir .gitignore).

APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stages
DB_USER=stages
DB_PASS=change_me

# Optionnel : connexion par socket Unix (prioritaire sur DB_HOST/DB_PORT)
# DB_SOCKET=/run/mysqld/mysqld.sock
