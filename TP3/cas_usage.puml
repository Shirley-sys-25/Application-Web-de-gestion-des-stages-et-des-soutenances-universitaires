@startuml cas_usage
' Diagramme de cas d'utilisation - TP3 - Projet informatique 2
' UC01 est inclus par tous les autres cas : aucun acces sans session.
skinparam dpi 200
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 28
left to right direction

actor "Étudiant" as E
actor "Responsable\npédagogique" as R
actor "Secrétariat" as S
actor "Administrateur" as A

rectangle "Application de gestion des stages et des soutenances" {
  usecase "UC02\nSoumettre une\ndemande de stage" as UC1
  usecase "UC03\nConsulter l'état de\nses demandes" as UC2
  usecase "UC04\nValider ou refuser\nune demande" as UC3
  usecase "UC05\nAffecter un\nencadreur" as UC4
  usecase "UC06\nProgrammer une\nsoutenance" as UC5
  usecase "UC07\nRechercher\nun dossier" as UC6
  usecase "UC08\nGérer les comptes\net les rôles" as UC7
  usecase "UC01\nSe connecter" as UC0
}

E --> UC1
E --> UC2
R --> UC3
S --> UC4
S --> UC5
S --> UC6
A --> UC7

UC1 ..> UC0 : <<include>>
UC2 ..> UC0 : <<include>>
UC3 ..> UC0 : <<include>>
UC4 ..> UC0 : <<include>>
UC5 ..> UC0 : <<include>>
UC6 ..> UC0 : <<include>>
UC7 ..> UC0 : <<include>>
@enduml
